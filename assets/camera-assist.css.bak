:root{--cam-bg:#06101b;--cam-panel:#0b1826;--cam-line:#203246;--cam-green:#38d996;--cam-red:#ff5d67;--cam-blue:#4aa8ff}
*{box-sizing:border-box}.camera-page{margin:0;background:var(--cam-bg);color:var(--text,#eef4fa);font-family:Inter,system-ui,sans-serif;min-height:100vh}.camera-topbar{display:flex;justify-content:space-between;gap:24px;align-items:center;padding:22px 28px;border-bottom:1px solid var(--cam-line);background:#081522;position:sticky;top:0;z-index:20}.camera-topbar h1{margin:2px 0;font-size:30px}.camera-topbar h1 span{color:var(--gold,#f5c542)}.camera-topbar p{margin:0;color:#91a4b7}.camera-top-actions{display:flex;gap:10px;flex-wrap:wrap}.camera-shell{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(350px,.85fr);gap:16px;padding:16px 22px}.camera-stage{padding:12px}.camera-side{display:flex;flex-direction:column;gap:12px}.camera-toolbar,.spread{display:flex;align-items:center;justify-content:space-between;gap:10px}.camera-status{display:flex;align-items:center;gap:9px;color:#a9b7c5}.status-dot{width:10px;height:10px;border-radius:50%;background:#687786;box-shadow:0 0 0 4px #68778622}.status-dot.live{background:var(--cam-green);box-shadow:0 0 0 4px #38d99622}.video-wrap{margin-top:10px;position:relative;background:#020609;border:1px solid var(--cam-line);border-radius:14px;overflow:hidden;aspect-ratio:16/9;min-height:360px}.video-wrap video{width:100%;height:100%;object-fit:contain;display:block}.video-message{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:40px;color:#9db0c2;background:radial-gradient(circle at center,#12283eaa,#020609ee)}.field-overlay{position:absolute;inset:0;pointer-events:none;opacity:.65}.yard-line{position:absolute;top:0;bottom:0;width:1px;background:#ffffff42;color:#fff;font:700 12px monospace;padding-top:7px}.y20{left:20%}.y40{left:40%}.y50{left:50%}.y60{left:60%}.y80{left:80%}.hash-line{position:absolute;left:0;right:0;height:1px;border-top:1px dashed #f5c54288}.hash-left{top:38%}.hash-right{top:62%}.roi{position:absolute;left:18%;right:18%;top:18%;bottom:18%;border:2px solid #4aa8ff88;border-radius:10px}.roi span{position:absolute;top:-22px;left:0;color:#8ec8ff;font:700 10px monospace}.live-badge{display:none;position:absolute;top:14px;right:14px;background:#ca2632dd;padding:7px 10px;border-radius:8px;font:800 11px monospace}.live-badge.show{display:block}.motion-meter{position:absolute;left:12px;right:12px;bottom:12px;background:#06101bdb;border:1px solid #29415a;border-radius:9px;padding:7px 10px;display:grid;grid-template-columns:52px 1fr 38px;gap:8px;align-items:center;font:700 10px monospace}.motion-meter>div{height:7px;background:#223244;border-radius:10px;overflow:hidden}.motion-meter i{display:block;height:100%;width:0;background:var(--cam-green);transition:width .12s}.capture-controls{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px}.capture-button{min-height:74px;border:1px solid #2e6a98;background:#103352;color:white;border-radius:12px;font-weight:900;font-size:17px;cursor:pointer}.capture-button span{display:block;color:#8ec8ff;font-size:10px;letter-spacing:.18em}.capture-button small{display:block;color:#9db0c2;font-size:10px;margin-top:4px}.capture-button.secondary{background:#163b2d;border-color:#2c805a}.capture-button.secondary span{color:#70edb3}.capture-button.neutral{background:#2b263f;border-color:#67569a}.capture-button.neutral span{color:#c6b6ff}.capture-button.danger{background:#461e27;border-color:#a33e50}.capture-button.danger span{color:#ff9caa}.capture-button.active{outline:3px solid var(--gold);transform:translateY(-1px)}.camera-side .card{padding:14px}.prediction-empty{color:#94a8bb;font-size:13px}.prediction-main{font-size:30px;font-weight:900;margin:8px 0}.prediction-split{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.prediction-split div{background:#101f2e;border:1px solid #20364d;border-radius:9px;padding:8px;text-align:center}.prediction-split strong{display:block;font-size:18px}.prediction-top3{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.prediction-top3 span{background:#192b3d;border-radius:999px;padding:6px 9px;font-size:11px}.confidence-chip{font:800 10px monospace;border:1px solid #3a536c;border-radius:999px;padding:5px 8px;color:#a9bdd0}.observation-grid,.draft-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:10px 0}.camera-page label{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:#92a7ba}.camera-page select,.camera-page input{width:100%;margin-top:4px;background:#0a1420;color:#edf4fa;border:1px solid #2a4057;border-radius:8px;padding:8px}.full{width:100%}.draft-card.ready{border-color:#38d996;box-shadow:0 0 0 2px #38d99622}.draft-actions{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap}.voice-line{margin-top:9px;padding:8px;background:#08121d;border-radius:7px;color:#92a7ba;font-size:11px}.voice-line.listening{color:#70edb3}.situation-row{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.quick-situations{display:flex;gap:5px;flex-wrap:wrap;margin-top:9px}.quick-situations button{border:1px solid #2c4359;background:#0d1d2c;color:#b9cad9;border-radius:7px;padding:6px 8px;font-size:10px;cursor:pointer}.settings-grid{display:grid;gap:9px;margin:10px 0}.settings-grid label:has(input[type=checkbox]){display:flex;align-items:center;gap:7px}.settings-grid input[type=checkbox]{width:auto;margin:0}.session-log{margin:0 22px 25px;padding:14px}.event-list{display:grid;gap:6px;margin-top:10px;max-height:220px;overflow:auto}.event-item{display:grid;grid-template-columns:90px 1fr auto;gap:10px;padding:8px 10px;background:#091623;border:1px solid #182c40;border-radius:8px;font-size:11px}.event-item time{color:#6f879d}.event-item b{color:#dce8f2}.event-item span{color:#8fa6ba}.camera-page code{color:#8ec8ff}.camera-page .card{background:var(--cam-panel);border:1px solid var(--cam-line);border-radius:14px}.camera-page .btn{text-decoration:none}@media(max-width:1050px){.camera-shell{grid-template-columns:1fr}.camera-side{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.settings-card{grid-column:1/-1}}@media(max-width:700px){.camera-topbar{position:static;align-items:flex-start;flex-direction:column;padding:16px}.camera-shell{padding:10px}.camera-side{display:flex}.video-wrap{min-height:230px}.capture-controls{grid-template-columns:repeat(2,1fr)}.session-log{margin:0 10px 18px}.observation-grid,.draft-grid{grid-template-columns:1fr 1fr}.camera-toolbar{align-items:flex-start;flex-direction:column}.situation-row{grid-template-columns:repeat(2,1fr)}}
